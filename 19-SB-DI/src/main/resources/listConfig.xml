<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
            http://www.springframework.org/schema/beans/spring-beans.xsd
            http://www.springframework.org/schema/context
            http://www.springframework.org/schema/context/spring-context-3.0.xsd">

	<bean id="studentSetterBean" class="com.tyss.list.Student">
		<property name="name" value="Linga"></property>	
		<property name="subjects" >
			<list>
				<value>JAVA</value>
				<value>ADVANCE JAVA</value>
				<value>HIBERNATE</value>
				<value>SPRING</value>
			</list>
		</property>		
	</bean>
	
	<bean id="studentConstructorBean" class="com.tyss.list.Student">
		<constructor-arg value="Dinga"></constructor-arg>
		<constructor-arg>
			<list>
				<value>JAVA</value>
				<value>ADVANCE JAVA</value>
				<value>HIBERNATE</value>
				<value>SPRING BOOT</value>
			</list>
		</constructor-arg>
	</bean>

</beans>